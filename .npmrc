# 包镜像源（国内加速）
registry=https://registry.npmmirror.com/

# 自动安装 peer 依赖，避免手动处理 peer 警告
auto-install-peers=true

# 不强制提升依赖到 node_modules 根（保持 pnpm 严格隔离语义）
shamefully-hoist=false

# 允许 workspace 内包互相引用时使用本地源
link-workspace-packages=true

# 保存时不要自动生成 lock 文件版本号变化（保持稳定）
save-exact=false

# 忽略 pnpm 在构建脚本中的警告
enable-pre-post-scripts=true
