NODE_ENV=development

# JWT 会话密钥（openssl rand -hex 48 生成）
JWT_SECRET=

# 数据库驱动：mysql（默认）| sqlite
DB_DRIVER=mysql

# mysql：连接串，形如 mysql://user:pass@host:3306/dbname
# sqlite：文件路径（相对 server 包目录；可指向仓库根目录 data/db.sqlite）
DB_URL=mysql://root:root@127.0.0.1:3306/scaffold

# 生产环境必填（逗号分隔 Origin）。开发环境由 loader 按 web.devPort 派生，无需设置。
# CORS_ORIGINS=https://example.com
