NODE_ENV=development
# 3000 端口常被本机其他工具（如 VS Code Live Preview）占用，默认改用 3100
PORT=3100
CORS_ORIGIN=http://localhost:5173

# 数据库（SQLite 文件，相对 server 包目录）
DB_STORAGE=./data/scaffold.db

# JWT 会话密钥（openssl rand -hex 48 生成）
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Swagger 接口文档（/api/docs），默认开发/测试开启、生产关闭，可显式指定 true/false
# SWAGGER_ENABLED=true
